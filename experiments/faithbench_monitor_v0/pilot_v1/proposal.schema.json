{
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "reason", "feedback", "evidence_refs", "gap"],
  "properties": {
    "action": {"enum": ["ALLOW_ACTION", "REVISE_REASONING", "REQUEST_EVIDENCE", "BLOCK_CALL", "END_LIMITED", "UNASSESSABLE"]},
    "reason": {"type": "string", "minLength": 1},
    "feedback": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["pointer", "quote"],
      "properties": {"pointer": {"type": "string", "pattern": "^/"}, "quote": {"type": "string", "minLength": 1}}
    }},
    "gap": {"anyOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false,
      "required": ["description", "evidence_type", "candidate_tools"],
      "properties": {"description": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "minLength": 1},
        "candidate_tools": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    }]}
  }
}
