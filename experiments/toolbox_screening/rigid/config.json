{
  "tool": "RIGID",
  "source": "https://github.com/IBM/RIGID",
  "source_commit": "55af3cc2dc17f1f47aaba4720195eaca10226ca4",
  "backbone_source": "https://github.com/facebookresearch/dinov2",
  "backbone_commit": "7764ea0f912e53c92e82eb78a2a1631e92725fc8",
  "backbone": "dinov2_vitl14",
  "seed": 100,
  "transform": {
    "resize": [224, 224],
    "to_tensor": true,
    "normalize_mean": [0.485, 0.456, 0.406],
    "normalize_std": [0.229, 0.224, 0.225]
  },
  "perturbation": {
    "distribution": "standard_normal",
    "space": "normalized_tensor",
    "lambda": 0.05,
    "draws_per_image": 1
  },
  "score": "cosine_similarity(original_embedding, perturbed_embedding); lower indicates synthetic",
  "raw_decision_score": "-similarity",
  "batch_size": 256,
  "shuffle": true,
  "num_workers": 2,
  "threshold": {
    "source": "separate 30-source-group calibration subset sampled from previously unused B-Free groups",
    "rule": "maximize image-level balanced accuracy; fake iff similarity < threshold; ties resolved by median of maximizing finite midpoints",
    "test_labels_used": false,
    "calibration_manifest": "calibration_manifest.jsonl"
  },
  "evaluation_manifest_sha256": "61d9455417f5d388edd663ff8497c641db58e3ee3349fda94e64c01b77b2d465"
}
